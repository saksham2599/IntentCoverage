{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentCoverage reviewed scope and decisions",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sourceRoots", "decisions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceRoots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decisions": {"type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["eligibility", "reason"],
      "properties": {"eligibility": {"enum": ["eligible", "excluded", "needs_review"]}, "reason": {"type": "string", "minLength": 1}}
    }}
  }
}
